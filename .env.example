# Variable names only. Copy to .env and fill in locally. Never commit .env.
# Optional features are configured as a group: set every variable of a group, or none. The backend lists what is missing at boot.

# --- Backend (services/backend) ---
PORT=
DB_PATH=
APP_URL=

# --- Contracts and chain (Mann) ---
HEDERA_TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# --- Chain indexer: set INVOICE_MARKET_ADDRESS to turn it on ---
INVOICE_MARKET_ADDRESS=
INDEXER_START_BLOCK=
HEDERA_RPC_URL=
# POST /api/invoices: this wallet creates the invoices on-chain (and becomes their supplier); needs INVOICE_MARKET_ADDRESS
SUPPLIER_PRIVATE_KEY=

# --- World approvals (set all three) ---
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=
APPROVAL_TTL_SECONDS=
# scripts/world-stepup-live.ts only
WORLD_LISTEN_PORT=

# --- ENS on Sepolia: publisher (set all four) ---
ENS_PUBLISHER_KEY=
ENS_RESOLVER_ADDRESS=
ENS_AGENT_NAME=
DEMO_VAULT_ADDRESS=
SEPOLIA_RPC_URL=
# scripts/ens/* only
ENS_PUBLISHER_ADDRESS=
SPONSOR_PRIVATE_KEY=
SPONSOR_ADDRESS=
ENS_USER_REGISTRY_ADDRESS=
ENS_PARENT_LABEL=

# --- HCS audit log: HCS_TOPIC_ID alone reads it; add the account and key to publish ---
HCS_TOPIC_ID=
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# --- World AgentKit (scripts/register-agent.ts, services/backend/src/world/agentkit.ts) ---
AGENTKIT_AGENT_KEY=
AGENTKIT_AGENT_ADDRESS=
WORLD_CHAIN_RPC_URL=
AGENTKIT_SIGNATURE_RPC_URL=

# --- Agents (agents/*). Shared by the investor agent and the buyer agent ---
# Which account agents spend from: buyer-vault (live, our BuyerVault contract) or hedera-agent-account (not available yet).
AGENT_ACCOUNT_PROVIDER=
# Milliseconds between loop passes, per agent. Defaults: buyer 15000, investor 20000.
BUYER_AGENT_POLL_INTERVAL_MS=
INVESTOR_AGENT_POLL_INTERVAL_MS=
# 1 = log decisions but never send a transaction.
DRY_RUN=
BACKEND_URL=
MARKET_ADDRESS=
# Buyer agent. Required unless DRY_RUN=1.
BUYER_AGENT_PRIVATE_KEY=
# Buyer agent. Optional. Default: packages/shared/src/addresses.json buyerVault.
BUYER_VAULT_ADDRESS=
# Buyer agent also reads HEDERA_TESTNET_RPC_URL (Contracts section). Default: hederaTestnet.rpcUrl.

# --- Investor agent (agents/investor-agent) ---
INVESTOR_PRIVATE_KEY=
SCORE_API_URL=
# Rules. Amounts in USDC (invoices settle in USDC), e.g. MAX_PRICE=50. Defaults: B, 100, 100, 500.
MIN_BAND=
MIN_DISCOUNT_BPS=
MAX_PRICE=
MAX_OPEN_EXPOSURE=
# Investor's Hedera account id (0.0.x) that pays for scores over x402. Its ECDSA key is INVESTOR_PRIVATE_KEY.
INVESTOR_ACCOUNT_ID=
# Caps on x402 score payments, in tinybars (defaults: 0.1 HBAR per call, 1 HBAR a day).
SCORE_MAX_PRICE_TINYBAR=
SCORE_DAILY_BUDGET_TINYBAR=

# --- Paid score API (services/paid-api, real x402 via a facilitator) ---
# Hedera account id (0.0.x) that receives score payments. Required: the server refuses to start without it.
PAY_TO=
# Price per score in tinybars (default 5000000 = 0.05 HBAR).
SCORE_PRICE=
# x402 facilitator that co-signs as fee payer and settles (default Blocky402 testnet).
FACILITATOR_URL=
PAID_API_PORT=
# Used by scripts/e2e.ts --testnet and the investor agent (SCORE_API_URL).
PAID_API_URL=

# --- SaucerSwap HBAR→USDC library (@invoiceagent/shared/saucerswap). Testnet only. ---
# Dedicated swap operator — do NOT reuse investor / supplier / HCS wallets as the default.
# Set both account and key, or neither (quote-only / dry-run still needs the account id to prepare).
SAUCERSWAP_OPERATOR_ACCOUNT_ID=
SAUCERSWAP_OPERATOR_PRIVATE_KEY=
# Must be testnet if set. Mainnet is rejected.
SAUCERSWAP_NETWORK=
# Optional endpoint overrides (defaults: testnet Mirror / Hashio / test-api.saucerswap.finance).
SAUCERSWAP_MIRROR_NODE_URL=
SAUCERSWAP_RPC_URL=
SAUCERSWAP_REST_API_URL=
# Policy caps. Amounts: SAUCERSWAP_MAX_SWAP_HBAR and SAUCERSWAP_GAS_RESERVE_HBAR are HBAR decimals (e.g. 10).
SAUCERSWAP_MAX_SWAP_HBAR=
SAUCERSWAP_MAX_SLIPPAGE_BPS=
# Minimum USDC out in 6-decimal base units (integer).
SAUCERSWAP_MIN_USDC_OUT=
SAUCERSWAP_GAS_RESERVE_HBAR=
SAUCERSWAP_QUOTE_TTL_MS=
SAUCERSWAP_GAS_LIMIT=
SAUCERSWAP_DEADLINE_SECONDS=
# 1 = never broadcast (also honored when DRY_RUN=1 in the Agents section).
SAUCERSWAP_DRY_RUN=
# Backend read-only /api/saucerswap/* — set to 1, or set SAUCERSWAP_OPERATOR_ACCOUNT_ID, to enable status/quote.
SAUCERSWAP_STATUS=
# Investor agent optional treasury swap (dedicated operator above; never reuses INVESTOR_* by default).
SAUCERSWAP_ENABLE_AGENT_SWAP=
# HBAR decimals: amount to swap per pass, and HBAR to keep on the operator after swapping.
SAUCERSWAP_SWAP_HBAR=
SAUCERSWAP_KEEP_HBAR=

# --- USDC settlement (every invoice payment moves USDC, HTS 0.0.5449; agents swap HBAR on SaucerSwap when short) ---
# Most HBAR one automatic swap may spend: investor agent top-up before funding / buyer agent vault top-up before paying.
USDC_TOPUP_MAX_HBAR=
# 0 = the buyer agent never swaps HBAR into its vault (the vault must already hold the USDC).
USDC_AUTO_TOPUP=
# Contract deploy (scripts/deploy-contracts.ts): vault limits in USDC, and an optional settlement token override.
DAILY_LIMIT_USDC=
APPROVAL_THRESHOLD_USDC=
SETTLEMENT_TOKEN_ADDRESS=
