# Variable names only. Copy to .env and fill in locally. Never commit .env.
# Optional features are configured as a group: set every variable of a group, or none. The backend lists what is missing at boot.

# --- Backend (services/backend) ---
PORT=
DB_PATH=
APP_URL=

# --- Contracts and chain (Mann) ---
HEDERA_TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# --- Chain indexer: set INVOICE_MARKET_ADDRESS to turn it on ---
INVOICE_MARKET_ADDRESS=
INDEXER_START_BLOCK=
HEDERA_RPC_URL=

# --- World approvals (set all three) ---
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=
APPROVAL_TTL_SECONDS=
# scripts/world-stepup-live.ts only
WORLD_LISTEN_PORT=

# --- ENS on Sepolia: publisher (set all four) ---
ENS_PUBLISHER_KEY=
ENS_RESOLVER_ADDRESS=
ENS_AGENT_NAME=
DEMO_VAULT_ADDRESS=
SEPOLIA_RPC_URL=
# scripts/ens/* only
ENS_PUBLISHER_ADDRESS=
SPONSOR_PRIVATE_KEY=
SPONSOR_ADDRESS=
ENS_USER_REGISTRY_ADDRESS=
ENS_PARENT_LABEL=

# --- HCS audit log: HCS_TOPIC_ID alone reads it; add the account and key to publish ---
HCS_TOPIC_ID=
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# --- World AgentKit (scripts/register-agent.ts, services/backend/src/world/agentkit.ts) ---
AGENTKIT_AGENT_KEY=
AGENTKIT_AGENT_ADDRESS=
WORLD_CHAIN_RPC_URL=
AGENTKIT_SIGNATURE_RPC_URL=
