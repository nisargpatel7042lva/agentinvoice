{
  "name": "agentinvoice",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "services/*",
    "agents/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "forge": "cd contracts && forge test -q",
    "verify:fast": "bun run typecheck && bun run lint && bun run test && bun run forge",
    "verify": "bun run verify:fast && bun run e2e:local",
    "e2e:local": "tsx scripts/e2e.ts --local",
    "e2e:testnet": "tsx scripts/e2e.ts --testnet",
    "dev:backend": "tsx --env-file-if-exists=.env services/backend/src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hashgraph/sdk": "^2.81.0",
    "@types/node": "^26.6.6",
    "@worldcoin/agentkit": "^0.2.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "viem": "^2.57.16",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "packageManager": "bun@1.4.2"
}
