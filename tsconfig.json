{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "services/*/src/**/*.ts",
    "agents/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "**/*.test.ts"
  ],
  "exclude": ["node_modules", "**/dist", "contracts"]
}
