# Copy to apps/web/.env.local. Public values only: NEXT_PUBLIC_* ends up in the browser bundle.
NEXT_PUBLIC_BACKEND_URL=
# The name suppliers type for the deployed BuyerVault (default buyer-agent.eth).
NEXT_PUBLIC_BUYER_ENS_NAME=
# Optional: a private Hedera JSON-RPC relay instead of hashio.
NEXT_PUBLIC_HEDERA_RPC_URL=
# Buyer vault deploy from the profile page (public addresses): the buyer agent wallet that pays from the vault, and the approval verifier.
NEXT_PUBLIC_AGENT_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=
