# Copy to apps/web/.env.local. Public values only: NEXT_PUBLIC_* ends up in the browser bundle.
NEXT_PUBLIC_BACKEND_URL=
# 1 = use fixtures from @invoiceagent/shared. Must be unset in production.
NEXT_PUBLIC_MOCK=
# Real mode: the name suppliers type for the deployed BuyerVault (default buyer-agent.eth).
NEXT_PUBLIC_BUYER_ENS_NAME=
# Optional: a private Hedera JSON-RPC relay instead of hashio.
NEXT_PUBLIC_HEDERA_RPC_URL=
